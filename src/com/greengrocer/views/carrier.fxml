<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="960.0" styleClass="dashboard-container"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.greengrocer.controllers.CarrierController">
   <children>
      <VBox spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <!-- Header Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="header-bar">
               <children>
                  <Label text="🚚" style="-fx-font-size: 28px;" />
                  <VBox spacing="2">
                     <Label fx:id="welcomeLabel" text="Carrier Dashboard" styleClass="header-title" />
                     <Label fx:id="avgRatingLabel" text="⭐ Rating: N/A" styleClass="header-subtitle" />
                  </VBox>
                  <Label fx:id="statusLabel" styleClass="status-error" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleLogout" text="🚪 Logout" styleClass="button-danger" />
               </children>
            </HBox>
            
            <!-- Tab Pane -->
            <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
              <tabs>
              
                <!-- AVAILABLE ORDERS TAB -->
                <Tab text="📦 Available Orders">
                  <content>
                    <HBox spacing="15" style="-fx-padding: 20;">
                       <children>
                          <!-- Orders Table -->
                          <VBox spacing="10" HBox.hgrow="ALWAYS">
                             <children>
                                <Label text="Orders Waiting for Pickup" styleClass="section-title" />
                                <TableView fx:id="availableTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                                  <columns>
                                    <TableColumn fx:id="colAvId" prefWidth="70" text="Order #" />
                                    <TableColumn fx:id="colAvCustomer" prefWidth="120" text="Customer" />
                                    <TableColumn fx:id="colAvDate" prefWidth="130" text="📅 Order Date" />
                                    <TableColumn fx:id="colAvScheduled" prefWidth="130" text="🚚 Scheduled" />
                                    <TableColumn fx:id="colAvTotal" prefWidth="80" text="💰 Total" />
                                  </columns>
                                </TableView>
                                <Button onAction="#handleTakeOrder" styleClass="button-primary" text="✅ Take Selected Order" maxWidth="Infinity" />
                             </children>
                          </VBox>
                          
                          <!-- Details Panel - No white box -->
                          <VBox spacing="10" prefWidth="300" style="-fx-padding: 15; -fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10;">
                             <children>
                                <Label text="Order Details" styleClass="section-title" style="-fx-text-fill: white;" />
                                <Separator />
                                <Label text="Customer:" style="-fx-font-weight: bold; -fx-text-fill: white;" />
                                <Label fx:id="detailCustomerName" text="-" style="-fx-text-fill: white;" />
                                <Label text="Address:" style="-fx-font-weight: bold; -fx-text-fill: white;" />
                                <Label fx:id="detailAddress" text="-" wrapText="true" style="-fx-text-fill: white;" />
                                <Label text="📅 Scheduled Delivery:" style="-fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
                                <Label fx:id="detailScheduledDate" text="-" style="-fx-text-fill: #4CAF50;" />
                                <Label text="Products:" style="-fx-font-weight: bold; -fx-text-fill: white;" />
                                <Label fx:id="detailProductList" text="-" wrapText="true" style="-fx-padding: 5; -fx-background-color: transparent; -fx-text-fill: white;" />
                                <Separator />
                                <Label fx:id="detailTotal" text="Total: 0.00 TL" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #FFD700;" />
                             </children>
                          </VBox>
                       </children>
                    </HBox>
                  </content>
                </Tab>
                
                <!-- MY DELIVERIES TAB -->
                <Tab text="🚚 My Deliveries">
                  <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                       <children>
                          <HBox spacing="15" alignment="CENTER_LEFT">
                             <Label text="Active Deliveries" styleClass="section-title" />
                             <Region HBox.hgrow="ALWAYS" />
                             <Button onAction="#handleRefresh" text="🔄 Refresh" styleClass="button-secondary" />
                          </HBox>
                          
                          <TableView fx:id="deliveryTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                              <TableColumn fx:id="colDelId" prefWidth="80" text="Order #" />
                              <TableColumn fx:id="colDelDate" prefWidth="150" text="📅 Order Date" />
                              <TableColumn fx:id="colDelScheduled" prefWidth="150" text="🚚 Scheduled" />
                              <TableColumn fx:id="colDelTotal" prefWidth="100" text="💰 Total" />
                              <TableColumn fx:id="colDelStatus" prefWidth="100" text="📊 Status" />
                            </columns>
                          </TableView>
                          
                          <HBox spacing="15" alignment="CENTER_RIGHT" styleClass="glass-card-small">
                             <children>
                                <Label text="Mark orders as delivered when completed" styleClass="text-secondary" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#handleCompleteDelivery" text="📦 Complete Delivery" styleClass="button-accent" style="-fx-pref-width: 180; -fx-pref-height: 40;" />
                             </children>
                          </HBox>
                       </children>
                    </VBox>
                  </content>
                </Tab>
                
                <!-- COMPLETED DELIVERIES TAB -->
                <Tab text="✅ Completed">
                  <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                       <children>
                          <HBox spacing="15" alignment="CENTER_LEFT">
                             <Label text="Delivery History" styleClass="section-title" />
                             <Region HBox.hgrow="ALWAYS" />
                             <Button onAction="#handleRefresh" text="🔄 Refresh" styleClass="button-secondary" />
                          </HBox>
                          
                          <TableView fx:id="completedTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                              <TableColumn fx:id="colCompId" prefWidth="80" text="Order #" />
                              <TableColumn fx:id="colCompDate" prefWidth="150" text="📅 Order Date" />
                              <TableColumn fx:id="colCompDeliveryDate" prefWidth="150" text="🚚 Delivered" />
                              <TableColumn fx:id="colCompTotal" prefWidth="100" text="💰 Total" />
                            </columns>
                          </TableView>
                       </children>
                    </VBox>
                  </content>
                </Tab>
                
                <!-- MY RATINGS TAB -->
                <Tab text="⭐ My Ratings">
                  <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                       <children>
                          <HBox spacing="15" alignment="CENTER_LEFT">
                             <Label text="Customer Feedback" styleClass="section-title" />
                             <Region HBox.hgrow="ALWAYS" />
                             <Label fx:id="ratingsSummaryLabel" text="" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
                             <Button onAction="#handleRefreshRatings" text="🔄 Refresh" styleClass="button-secondary" />
                          </HBox>
                          
                          <TableView fx:id="ratingsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                              <TableColumn fx:id="colRatingOrder" prefWidth="80" text="Order #" />
                              <TableColumn fx:id="colRatingCustomer" prefWidth="150" text="Customer" />
                              <TableColumn fx:id="colRatingStars" prefWidth="100" text="⭐ Rating" />
                              <TableColumn fx:id="colRatingComment" prefWidth="300" text="💬 Comment" />
                              <TableColumn fx:id="colRatingDate" prefWidth="150" text="📅 Date" />
                            </columns>
                          </TableView>
                       </children>
                    </VBox>
                  </content>
                </Tab>
                
                <!-- LEADERBOARD TAB -->
                <Tab text="🏆 Leaderboard">
                  <content>
                    <VBox spacing="15" style="-fx-padding: 20;">
                       <children>
                          <HBox spacing="15" alignment="CENTER_LEFT">
                             <Label text="Carrier Leaderboard" styleClass="section-title" />
                             <Region HBox.hgrow="ALWAYS" />
                             <Label fx:id="myRankLabel" text="" style="-fx-font-size: 14px;" />
                             <Button onAction="#handleRefreshLeaderboard" text="🔄 Refresh" styleClass="button-secondary" />
                          </HBox>
                          
                          <TableView fx:id="leaderboardTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                            <columns>
                              <TableColumn fx:id="colRank" prefWidth="60" text="🏅" />
                              <TableColumn fx:id="colCarrierName" prefWidth="180" text="👤 Carrier" />
                              <TableColumn fx:id="colDeliveries" prefWidth="100" text="📦 Deliveries" />
                              <TableColumn fx:id="colAvgRating" prefWidth="100" text="⭐ Rating" />
                              <TableColumn fx:id="colRatingCount" prefWidth="80" text="Reviews" />
                              <TableColumn fx:id="colTotalValue" prefWidth="120" text="💰 Total Value" />
                            </columns>
                          </TableView>
                       </children>
                    </VBox>
                  </content>
                </Tab>
                
              </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
