<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="540.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.greengrocer.controllers.CustomerController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #eee; -fx-padding: 10;">
               <children>
                  <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Welcome Customer" />
                  <Label fx:id="statusLabel" textFill="RED" />
                  <javafx.scene.layout.Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleLogout" text="🚪 Logout" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
               </children>
            </HBox>
            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
              <tabs>
                <Tab text="Shop">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <VBox layoutX="14.0" layoutY="14.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                 <children>
                                    <TableView fx:id="shopTable" VBox.vgrow="ALWAYS">
                                      <columns>
                                        <TableColumn fx:id="colShopImage" prefWidth="60.0" text="Image" />
                                        <TableColumn fx:id="colShopName" prefWidth="180.0" text="Product Name" />
                                        <TableColumn fx:id="colShopType" prefWidth="80.0" text="Type" />
                                          <TableColumn fx:id="colShopPrice" prefWidth="80.0" text="Price" />
                                          <TableColumn fx:id="colShopStock" prefWidth="80.0" text="Stock" />
                                      </columns>
                                    </TableView>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label text="Filter:" />
                                          <javafx.scene.control.ComboBox fx:id="filterTypeCombo" prefWidth="120.0" promptText="All Types" onAction="#handleFilter" />
                                          <Label text="Sort:" />
                                          <javafx.scene.control.ComboBox fx:id="sortCombo" prefWidth="150.0" promptText="Default" onAction="#handleSort" />
                                          <Button mnemonicParsing="false" onAction="#handleResetFilter" text="Reset" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label text="Quantity:" />
                                          <TextField fx:id="quantityField" prefWidth="80.0" />
                                          <Button mnemonicParsing="false" onAction="#handleAddToCart" text="Add to Cart" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                  </content>
                </Tab>
                <Tab text="My Cart">
                  <content>
                    <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <VBox layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                 <children>
                                    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                                      <columns>
                                        <TableColumn fx:id="colCartName" prefWidth="200.0" text="Product" />
                                        <TableColumn fx:id="colCartPrice" prefWidth="100.0" text="Price" />
                                          <TableColumn fx:id="colCartQty" prefWidth="100.0" text="Quantity" />
                                          <TableColumn fx:id="colCartTotal" prefWidth="100.0" text="Total" />
                                      </columns>
                                    </TableView>
                                    <HBox alignment="CENTER_RIGHT" spacing="20.0">
                                       <children>
                                          <Button mnemonicParsing="false" onAction="#handleRemoveFromCart" text="Remove Selected" />
                                          <Label fx:id="cartTotalLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Total: $0.00" />
                                          <Button mnemonicParsing="false" onAction="#handleCheckout" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Checkout" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                  </content>
                </Tab>
                <Tab text="My Orders">
                   <content>
                      <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                         <children>
                            <VBox layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                               <children>
                                  <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                      <TableColumn fx:id="colOrderId" prefWidth="100.0" text="Order ID" />
                                      <TableColumn fx:id="colOrderDate" prefWidth="200.0" text="Date" />
                                        <TableColumn fx:id="colOrderTotal" prefWidth="100.0" text="Total" />
                                        <TableColumn fx:id="colOrderStatus" prefWidth="150.0" text="Status" />
                                    </columns>
                                  </TableView>
                                  <HBox alignment="CENTER_RIGHT">
                                     <children>
                                        <Button mnemonicParsing="false" onAction="#handleRefreshOrders" text="Refresh" />
                                     </children>
                                  </HBox>
                               </children>
                            </VBox>
                         </children>
                      </AnchorPane>
                   </content>
                </Tab>
              </tabs>
            </TabPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
