<?xml version="1.0" encoding="UTF-8"?>
<!--
    login.fxml - Login Screen
    
    Description: Main entry point of the application. Provides user authentication
                 with username/password fields and navigation to registration.
    
    Controller: com.greengrocer.controllers.LoginController
    
    Features:
    - Username and password input fields
    - Login authentication
    - Navigation to registration screen
    - "Forgot Password" functionality

    
    @author Group10
    @version 1.0
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.greengrocer.controllers.LoginController"
           styleClass="login-container" prefWidth="960" prefHeight="650">
    
    <!-- Background with gradient -->
    <VBox alignment="CENTER" spacing="0">
        
        <!-- Login Card (Glassmorphism) -->
        <VBox alignment="CENTER" spacing="20" styleClass="glass-card" maxWidth="400" maxHeight="500">
            <padding>
                <Insets bottom="40" left="40" right="40" top="40" />
            </padding>
            
            <!-- Logo Icon -->
            <ImageView fitHeight="80" fitWidth="80" preserveRatio="true">
                <image>
                    <Image url="@../assets/icon.png" />
                </image>
            </ImageView>
            
            <!-- Title -->
            <Label text="Greengrocer" styleClass="title-label">
                <font>
                    <Font size="32" />
                </font>
            </Label>
            
            <!-- Subtitle -->
            <Label text="Fresh Produce Management System" styleClass="text-secondary">
                <font>
                    <Font size="13" />
                </font>
            </Label>
            
            <!-- Spacer -->
            <VBox prefHeight="10" />
            
            <!-- Username Field -->
            <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                <Label text="Username" styleClass="text-label" />
                <TextField fx:id="usernameField" promptText="Enter your username" prefWidth="280" styleClass="text-field" onAction="#handleUsernameDone" />
            </VBox>
            
            <!-- Password Field -->
            <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="280">
                <Label text="Password" styleClass="text-label" />
                <PasswordField fx:id="passwordField" promptText="Enter your password" prefWidth="280" styleClass="password-field" onAction="#handleLogin" />
            </VBox>
            
            <!-- Error Label -->
            <Label fx:id="errorLabel" styleClass="status-error" wrapText="true" maxWidth="280" />
            
            <!-- Login Button -->
            <Button fx:id="loginButton" onAction="#handleLogin" text="Login" 
                    styleClass="button-primary" prefWidth="280" prefHeight="45">
                <font>
                    <Font size="15" />
                </font>
            </Button>
            
            <!-- Register Button -->
            <Button fx:id="registerButton" onAction="#handleOpenRegister" text="Register as Customer" 
                    styleClass="button-secondary" prefWidth="280">
                <font>
                    <Font size="13" />
                </font>
            </Button>

        </VBox>
    </VBox>
    
</StackPane>
